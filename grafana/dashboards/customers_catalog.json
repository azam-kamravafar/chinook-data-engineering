    {
      "id": 2,
      "type": "stat",
      "title": "Top 10 Buyers Revenue Share | سهم ۱۰ خریدار برتر از درآمد",
      "description": "Percentage of total selected-period sales revenue generated by the 10 highest-revenue source customers. Customers are identified by CustomerId across historical SCD2 versions. It equals 100% if the selected range has at most 10 buying customers.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    round(\n        100.0 * sumIf(customer_revenue, buyer_rank <= 10)\n        / nullIf(sum(customer_revenue), 0),\n        2\n    ) AS top_10_buyer_revenue_share\nFROM\n(\n    SELECT\n        customer_id,\n        customer_revenue,\n        row_number() OVER (ORDER BY customer_revenue DESC, customer_id) AS buyer_rank\n    FROM\n    (\n        SELECT\n            c.CustomerId AS customer_id,\n            sum(f.SalesAmount) AS customer_revenue\n        FROM ChinookDW.FactSales AS f\n        INNER JOIN ChinookDW.DimCustomer AS c\n            ON f.CustomerKey = c.CustomerKey\n        INNER JOIN ChinookDW.DimDate AS d\n            ON f.DateKey = d.DateKey\n        WHERE $__dateFilter(d.FullDate)\n        GROUP BY c.CustomerId\n    )\n);",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#AB94F8"
          },
          "decimals": 1,
          "unit": "percent",
