    {
      "id": 5,
      "type": "timeseries",
      "title": "Monthly Buying Customers | روند ماهانه مشتریان خریدار",
      "description": "Distinct purchasing source customers (CustomerId) per calendar month. Each month is a separate count; one customer may be counted across multiple months. Partial months reflect selected date range.",
