    {
      "id": 8,
      "type": "barchart",
      "title": "Buying Customers by Country | مشتریان خریدار به تفکیک کشور",
      "description": "Distinct source customers with purchases attributed to each historical customer country in the selected range. If a customer purchased while recorded in different countries, that CustomerId can appear in multiple bars.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
