            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT ifNull(nullIf(c.Country,''),'Unknown country') AS country,\n       uniqExact(c.CustomerId) AS buyers\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimCustomer c ON f.CustomerKey = c.CustomerKey\nINNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate)\nGROUP BY country ORDER BY buyers DESC LIMIT 10;",
