    {
      "id": 6,
      "type": "timeseries",
      "title": "Monthly Average Order Value | میانگین ماهانه ارزش سفارش",
      "description": "Monthly sales revenue / distinct invoices, using transactions inside the selected range. Values can represent partial months if the date range starts or ends mid-month.",
