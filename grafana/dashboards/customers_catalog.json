          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT ifNull(nullIf(t.MediaTypeName,''),'Unknown type') AS media_type,\n       round(sum(f.SalesAmount),2) AS revenue\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimTrack t ON f.TrackKey = t.TrackKey\nINNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate)\nGROUP BY media_type ORDER BY revenue DESC;",
          "format": 1,
          "pluginVersion": "4.23.5"
