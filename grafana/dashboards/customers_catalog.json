          },
          "queryType": "timeseries",
          "editorType": "sql",
          "rawSql": "SELECT toDateTime(toStartOfMonth(d.FullDate)) AS time,\n       uniqExact(c.CustomerId) AS active_buyers\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\nINNER JOIN ChinookDW.DimCustomer c ON f.CustomerKey = c.CustomerKey\nWHERE $__dateFilter(d.FullDate)\nGROUP BY time ORDER BY time;",
