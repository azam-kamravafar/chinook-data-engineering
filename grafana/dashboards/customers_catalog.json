    {
      "id": 11,
      "type": "barchart",
      "title": "Top 10 Catalog Collections by Revenue | ۱۰ مجموعه برتر کاتالوگ از نظر درآمد",
      "description": "Revenue from the top 10 named album/collection and artist combinations in the selected period. Chinook AlbumTitle can include TV collections as well as musical albums; rows lacking an album title are excluded. Tied revenues use a deterministic alphabetic ordering.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    concat(\n        ifNull(t.AlbumTitle, 'Unknown collection'),\n        ' · ',\n        ifNull(nullIf(t.ArtistName, ''), 'Unknown creator')\n    ) AS collection,\n    round(sum(f.SalesAmount), 2) AS revenue\nFROM ChinookDW.FactSales AS f\nINNER JOIN ChinookDW.DimTrack AS t\n    ON f.TrackKey = t.TrackKey\nINNER JOIN ChinookDW.DimDate AS d\n    ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate)\n  AND t.AlbumTitle IS NOT NULL\n  AND t.AlbumTitle != ''\nGROUP BY t.AlbumTitle, t.ArtistName\nORDER BY revenue DESC, collection ASC\nLIMIT 10;",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
