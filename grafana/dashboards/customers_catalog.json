    {
      "id": 7,
      "type": "barchart",
      "title": "Top 10 Customers by Revenue | ۱۰ مشتری برتر از نظر درآمد",
      "description": "Top 10 buyers by sales revenue within the selected date range. All SCD2 records are consolidated by source CustomerId; the display name is taken from the highest CustomerKey version represented in sales during the selected interval.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    concat(\n        concat(argMax(c.FirstName, c.CustomerKey), ' ', argMax(c.LastName, c.CustomerKey)),\n        ' · #',\n        toString(c.CustomerId)\n    ) AS customer,\n    round(sum(f.SalesAmount), 2) AS revenue\nFROM ChinookDW.FactSales AS f\nINNER JOIN ChinookDW.DimCustomer AS c\n    ON f.CustomerKey = c.CustomerKey\nINNER JOIN ChinookDW.DimDate AS d\n    ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate)\nGROUP BY c.CustomerId\nORDER BY revenue DESC, c.CustomerId\nLIMIT 10;",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "color": {
