      "id": 1,
      "type": "stat",
      "title": "Buying Customers | مشتریان خریدار",
      "description": "Distinct source customers who placed an order in the selected period.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT uniqExact(c.CustomerId) AS active_customers\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimCustomer c ON f.CustomerKey = c.CustomerKey\nINNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate);",
