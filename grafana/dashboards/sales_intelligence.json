    {
      "id": 4,
      "type": "stat",
      "title": "Total Revenue | درآمد کل",
      "description": "Total invoice-line revenue for the selected dates. Sum of FactSales.SalesAmount (USD).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "\r\nSELECT\r\n    round(sum(f.SalesAmount), 2) AS total_revenue\r\n\r\nFROM ChinookDW.FactSales AS f\r\n\r\nINNER JOIN ChinookDW.DimDate AS d\r\n    ON f.DateKey = d.DateKey\r\n\r\nWHERE $__dateFilter(d.FullDate);\r\n",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
