            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "\r\nSELECT\r\n    uniqExact(c.CustomerId) AS unique_customers\r\n\r\nFROM ChinookDW.FactSales AS f\r\n\r\nINNER JOIN ChinookDW.DimCustomer AS c\r\n    ON f.CustomerKey = c.CustomerKey\r\n\r\nINNER JOIN ChinookDW.DimDate AS d\r\n    ON f.DateKey = d.DateKey\r\n\r\nWHERE $__dateFilter(d.FullDate);\r\n",
          "format": 1,
