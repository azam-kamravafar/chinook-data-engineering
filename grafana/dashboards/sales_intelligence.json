    {
      "id": 3,
      "type": "barchart",
      "title": "Top Artists & Shows | هنرمندان و مجموعه‌های پردرآمد",
      "description": "Top 10 DimTrack.ArtistName groups by FactSales revenue. Source artist labels may contain television show or series names; revenue is filtered to selected dates.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "\r\nSELECT\r\n    ifNull(\r\n        nullIf(t.ArtistName, ''),\r\n        'Unknown Artist'\r\n    ) AS artist,\r\n\r\n    round(sum(f.SalesAmount), 2) AS revenue\r\n\r\nFROM ChinookDW.FactSales AS f\r\n\r\nINNER JOIN ChinookDW.DimTrack AS t\r\n    ON f.TrackKey = t.TrackKey\r\n\r\nINNER JOIN ChinookDW.DimDate AS d\r\n    ON f.DateKey = d.DateKey\r\n\r\nWHERE $__dateFilter(d.FullDate)\r\n\r\nGROUP BY artist\r\n\r\nORDER BY revenue DESC\r\n\r\nLIMIT 10;\r\n",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
