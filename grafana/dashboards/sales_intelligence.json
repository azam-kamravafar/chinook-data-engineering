          "editorType": "sql",
          "rawSql": "SELECT\n    ifNull(nullIf(c.Country, ''), 'Unknown country') AS country,\n    round(sum(f.SalesAmount), 2) AS revenue\nFROM ChinookDW.FactSales AS f\nINNER JOIN ChinookDW.DimCustomer AS c ON f.CustomerKey = c.CustomerKey\nINNER JOIN ChinookDW.DimDate AS d ON f.DateKey = d.DateKey\nWHERE $__dateFilter(d.FullDate)\nGROUP BY country\nORDER BY revenue DESC\nLIMIT 8;",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
