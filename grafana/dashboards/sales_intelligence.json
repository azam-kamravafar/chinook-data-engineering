    {
      "id": 6,
      "type": "stat",
      "title": "Average Order Value | میانگین ارزش سفارش",
      "description": "Average order value = total SalesAmount divided by distinct InvoiceId in the selected range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "\r\nSELECT\r\n    round(\r\n        sum(f.SalesAmount) /\r\n        nullIf(uniqExact(f.InvoiceId), 0),\r\n        2\r\n    ) AS average_order_value\r\n\r\nFROM ChinookDW.FactSales AS f\r\n\r\nINNER JOIN ChinookDW.DimDate AS d\r\n    ON f.DateKey = d.DateKey\r\n\r\nWHERE $__dateFilter(d.FullDate);\r\n",
          "format": 1,
