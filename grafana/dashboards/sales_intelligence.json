    {
      "id": 11,
      "type": "barchart",
      "title": "Order Size Distribution | توزیع تعداد اقلام هر سفارش",
      "description": "Invoices grouped into basket-size bands based on SUM(FactSales.Quantity) per distinct InvoiceId for the selected dates. Each invoice is counted exactly once; bands are 1–2, 3–4, 5–7 and 8+ units.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    multiIf(\n        items_per_order <= 2, '01 · 1–2 items',\n        items_per_order <= 4, '02 · 3–4 items',\n        items_per_order <= 7, '03 · 5–7 items',\n        '04 · 8+ items'\n    ) AS basket_size,\n    count() AS orders\nFROM\n(\n    SELECT\n        f.InvoiceId,\n        sum(f.Quantity) AS items_per_order\n    FROM ChinookDW.FactSales AS f\n    INNER JOIN ChinookDW.DimDate AS d\n        ON f.DateKey = d.DateKey\n    WHERE $__dateFilter(d.FullDate)\n    GROUP BY f.InvoiceId\n)\nGROUP BY basket_size\nORDER BY basket_size;",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
