    {
      "id": 13,
      "type": "table",
      "title": "Integrity Test Register | وضعیت آزمون‌های یکپارچگی",
      "description": "Seven explicit warehouse-wide assertions, each with the count of offending rows or pairs. PASS means 0 detected errors for that rule, not proof of end-to-end production reliability. Day-grain SCD rule does not validate within-day time. | ۷ آزمون مشخص در کل تاریخچه؛ صفر بودن موارد شناسایی‌شده به معنی تأیید همه بخش‌های پایپ‌لاین نیست.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    check_name,\n    issues,\n    if(issues = 0, 'PASS', 'FAIL') AS result,\n    'ALL HISTORY' AS scope\nFROM (\n    SELECT 'Duplicate InvoiceLineId' AS check_name,\n           count() - uniqExact(InvoiceLineId) AS issues\n    FROM ChinookDW.FactSales\n\n    UNION ALL\n    SELECT 'SalesAmount vs Quantity × UnitPrice' AS check_name,\n           countIf(SalesAmount != round(Quantity * UnitPrice, 2)) AS issues\n    FROM ChinookDW.FactSales\n\n    UNION ALL\n    SELECT 'Missing dimension keys' AS check_name,\n           countIf(\n               (CustomerKey NOT IN (SELECT CustomerKey FROM ChinookDW.DimCustomer))\n               OR (TrackKey NOT IN (SELECT TrackKey FROM ChinookDW.DimTrack))\n               OR (DateKey NOT IN (SELECT DateKey FROM ChinookDW.DimDate))\n           ) AS issues\n    FROM ChinookDW.FactSales\n\n    UNION ALL\n    SELECT 'Day-grain SCD validity mismatch' AS check_name,\n           countIf(\n               d.FullDate < toDate(c.ValidFrom)\n               OR (c.ValidTo IS NOT NULL AND d.FullDate >= toDate(c.ValidTo))\n           ) AS issues\n    FROM ChinookDW.FactSales f\n    INNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\n    INNER JOIN ChinookDW.DimCustomer c ON f.CustomerKey = c.CustomerKey\n\n    UNION ALL\n    SELECT 'Overlapping SCD2 version pairs' AS check_name,\n           count() AS issues\n    FROM ChinookDW.DimCustomer a\n    INNER JOIN ChinookDW.DimCustomer b\n      ON a.CustomerId = b.CustomerId AND a.CustomerKey < b.CustomerKey\n    WHERE a.ValidFrom < ifNull(b.ValidTo, toDateTime64('2100-01-01 00:00:00', 3))\n      AND b.ValidFrom < ifNull(a.ValidTo, toDateTime64('2100-01-01 00:00:00', 3))\n\n    UNION ALL\n    SELECT 'Not exactly one current SCD2 version' AS check_name,\n           count() AS issues\n    FROM (\n        SELECT CustomerId\n        FROM ChinookDW.DimCustomer\n        GROUP BY CustomerId\n        HAVING countIf(IsCurrent = 1) != 1\n    )\n\n    UNION ALL\n    SELECT 'Non-positive SCD2 validity windows' AS check_name,\n           countIf(isNotNull(ValidTo) AND ValidTo <= ValidFrom) AS issues\n    FROM ChinookDW.DimCustomer\n)\nORDER BY result ASC, check_name ASC;\n",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
