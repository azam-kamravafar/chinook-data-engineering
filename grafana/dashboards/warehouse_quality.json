    {
      "id": 5,
      "type": "stat",
      "title": "SCD Day Conflicts · All | خطای روز SCD · کل",
      "description": "FactSales rows outside the calendar-day validity range of the linked DimCustomer version across ALL history. Uses FullDate (day) rather than invoice timestamp; cannot verify intraday chronology. | بررسی تطابق روز فروش با بازه نسخه مشتری؛ نه دقت ساعت و دقیقه.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT countIf(\n    d.FullDate < toDate(c.ValidFrom)\n    OR (c.ValidTo IS NOT NULL AND d.FullDate >= toDate(c.ValidTo))\n) AS invalid_scd_day_links\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimDate d ON f.DateKey = d.DateKey\nINNER JOIN ChinookDW.DimCustomer c ON f.CustomerKey = c.CustomerKey;\n",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
