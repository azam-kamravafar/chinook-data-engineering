    {
      "id": 1,
      "type": "stat",
      "title": "Fact Rows · Period | ردیف‌های فکت · بازه",
      "description": "Count of FactSales rows with matching DimDate, restricted by selected date range. This is an observational volume metric, not itself a quality pass/fail. | تعداد سطرهای فکت در بازه انتخاب‌شده که تاریخشان در DimDate موجود است.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT count() AS fact_rows\nFROM ChinookDW.FactSales f\nINNER JOIN ChinookDW.DimDate d ON f.DateKey=d.DateKey\nWHERE $__dateFilter(d.FullDate);",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
