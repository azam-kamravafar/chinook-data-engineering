    {
      "id": 4,
      "type": "stat",
      "title": "Orphan Keys · All | کلید بی‌مرجع · کل",
      "description": "FactSales rows with a missing CustomerKey, TrackKey or DateKey in the related dimension. Entire history; expected 0. | کلیدهای خارجی فاقد مرجع در بُعدهای مشتری، آهنگ یا تاریخ.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT countIf(\n   (f.CustomerKey NOT IN (SELECT CustomerKey FROM ChinookDW.DimCustomer))\n   OR (f.TrackKey NOT IN (SELECT TrackKey FROM ChinookDW.DimTrack))\n   OR (f.DateKey NOT IN (SELECT DateKey FROM ChinookDW.DimDate))\n) AS orphan_fact_rows\nFROM ChinookDW.FactSales f;",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
