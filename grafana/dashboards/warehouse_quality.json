          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT concat(toString(versions),' version(s)') AS versions_group,\n       count() AS customers\nFROM (\n  SELECT CustomerId, count() AS versions\n  FROM ChinookDW.DimCustomer GROUP BY CustomerId\n)\nGROUP BY versions\nORDER BY versions;",
