    {
      "id": 9,
      "type": "table",
      "title": "Changed-Customer Versions | نسخه‌های مشتریان تغییریافته",
      "description": "Only customers with 2+ DimCustomer versions, shown one row per historical version for investigating SCD2 validity boundaries and current flags. All history; no hardcoded CustomerId. | جزئیات واقعی تمام نسخه‌های مشتریانی که تغییر داشته‌اند.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT\n    CustomerId AS customer_id,\n    CustomerKey AS version_key,\n    if(IsCurrent = 1, 'CURRENT', 'HISTORICAL') AS version_state,\n    ValidFrom AS valid_from,\n    ValidTo AS valid_to,\n    SourceEventId AS source_event_id\nFROM ChinookDW.DimCustomer\nWHERE CustomerId IN (\n    SELECT CustomerId\n    FROM ChinookDW.DimCustomer\n    GROUP BY CustomerId\n    HAVING count() > 1\n)\nORDER BY CustomerId ASC, ValidFrom DESC, CustomerKey DESC\nLIMIT 100;\n",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#68A9FF"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "customer_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
