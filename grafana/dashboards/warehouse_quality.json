    {
      "id": 6,
      "type": "stat",
      "title": "SCD Overlaps · All | هم‌پوشانی SCD · کل",
      "description": "Number of overlapping half-open validity interval pairs for the same source CustomerId. Entire DimCustomer history. Expected 0. | تعداد جفت نسخه‌هایی که بازه اعتبارشان هم‌پوشانی دارد.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ag50ui0it05c0f"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ag50ui0it05c0f"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "WITH toDateTime64('2100-01-01 00:00:00', 3) AS open_end\nSELECT count() AS overlap_pairs\nFROM ChinookDW.DimCustomer a\nINNER JOIN ChinookDW.DimCustomer b\n ON a.CustomerId=b.CustomerId AND a.CustomerKey < b.CustomerKey\nWHERE a.ValidFrom < ifNull(b.ValidTo, open_end)\n AND b.ValidFrom < ifNull(a.ValidTo, open_end);",
          "format": 1,
          "pluginVersion": "4.23.5"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
