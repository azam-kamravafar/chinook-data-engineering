    {
      "id": 12,
      "type": "table",
      "title": "Investigation Queue · Live | موارد نیازمند بررسی",
      "description": "Live across all history: FAILED, stuck PROCESSING (>5 minutes), or retry observations. CLEAR means no exception matching these specific rules, not verified Kafka/Airflow health. | رخدادهای نیازمند بررسی در کل تاریخچه؛ CLEAR به معنی سلامت قطعی کل پایپ‌لاین نیست.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHINOOK_POSTGRES}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHINOOK_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH flagged AS (\n    SELECT event_id::text AS \"Event ID\",\n           CASE WHEN status = 'FAILED' OR (status='PROCESSING' AND started_at_utc < NOW()-INTERVAL '5 minutes') THEN 'HIGH' ELSE 'REVIEW' END AS \"Priority\",\n           CASE WHEN status='FAILED' THEN 'Failed'\n                WHEN status='PROCESSING' AND started_at_utc < NOW()-INTERVAL '5 minutes' THEN 'Stuck >5m'\n                ELSE 'Retry observed' END AS \"Reason\",\n           status AS \"Status\",\n           attempt_count AS \"Attempts\",\n           updated_at_utc AS \"Updated\",\n           COALESCE(error_message,'') AS \"Details\"\n    FROM staging.event_processing\n    WHERE status='FAILED'\n       OR (status='PROCESSING' AND started_at_utc < NOW()-INTERVAL '5 minutes')\n       OR attempt_count>1\n    ORDER BY updated_at_utc DESC\n    LIMIT 25\n)\nSELECT * FROM flagged\nUNION ALL\nSELECT '—'::text, 'CLEAR'::text, 'No exceptions detected'::text,\n       '—'::text, 0::integer, NULL::timestamptz,\n       'No FAILED, stuck, or retried ledger events'::text\nWHERE NOT EXISTS (SELECT 1 FROM flagged);",
          "refId": "A"
        }
      ],
