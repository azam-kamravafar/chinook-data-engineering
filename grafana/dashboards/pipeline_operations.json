          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((AVG(EXTRACT(EPOCH FROM completed_at_utc-started_at_utc))*1000)::numeric,1) AS avg_ms FROM staging.event_processing WHERE status='APPLIED' AND completed_at_utc IS NOT NULL AND $__timeFilter(started_at_utc);",
