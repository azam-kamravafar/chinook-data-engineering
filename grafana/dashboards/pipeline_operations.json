    {
      "id": 10,
      "type": "barchart",
      "title": "Duration by Event | زمان هر رویداد",
      "description": "Latest 15 APPLIED events started in the selected period, each showing its measured processing duration. | مدت پردازش ۱۵ رویداد موفق اخیر در بازه انتخابی.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHINOOK_POSTGRES}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHINOOK_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Event ' || event_id::text AS event,\n       ROUND((EXTRACT(EPOCH FROM completed_at_utc-started_at_utc)*1000)::numeric,1)::double precision AS duration_ms\nFROM staging.event_processing\nWHERE status='APPLIED' AND completed_at_utc IS NOT NULL AND $__timeFilter(started_at_utc)\nORDER BY completed_at_utc DESC LIMIT 15;",
          "refId": "A"
        }
      ],
      "transformations": [],
