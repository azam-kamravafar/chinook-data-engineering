    {
      "id": 9,
      "type": "timeseries",
      "title": "Daily Event Starts | رویدادهای روزانه",
      "description": "Daily count of ledger events by started_at_utc in selected period. Empty days are not fabricated. | تعداد آغاز رویدادها در هر روز از بازه انتخابی.",
      "datasource": {
