    {
      "id": 11,
      "type": "table",
      "title": "Recent Events | آخرین رویدادها",
      "description": "Up to 25 most recent events whose start falls in the selected range. Columns ordered for quick scanning; errors are in the Investigation Queue below. Status reflects current ledger state. | آخرین رویدادها؛ جزئیات خطا در صف بررسی پایین صفحه.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHINOOK_POSTGRES}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHINOOK_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    event_id AS \"Event ID\",\n    entity_id AS \"Customer ID\",\n    status AS \"Status\",\n    attempt_count AS \"Attempts\",\n    CASE WHEN completed_at_utc IS NOT NULL THEN\n        ROUND((EXTRACT(EPOCH FROM completed_at_utc - started_at_utc) * 1000)::numeric, 1)::double precision\n    END AS \"Duration (ms)\",\n    started_at_utc AS \"Started\",\n    completed_at_utc AS \"Completed\"\nFROM staging.event_processing\nWHERE $__timeFilter(started_at_utc)\nORDER BY started_at_utc DESC\nLIMIT 25;",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
