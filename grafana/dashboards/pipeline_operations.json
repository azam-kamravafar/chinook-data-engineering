    {
      "id": 7,
      "type": "stat",
      "title": "Avg Duration | میانگین زمان پردازش",
      "description": "Average completed_at_utc − started_at_utc for successful events started in the selected period (milliseconds). Not end-to-end latency. | میانگین زمان پردازش موفق در بازه انتخابی، نه تأخیر Kafka.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHINOOK_POSTGRES}"
      },
      "targets": [
        {
          "datasource": {
